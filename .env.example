# ---------------------------------------------------------------------------
# Solo Coach Onboarding — local configuration
#   cp .env.example .env     then fill in your API keys below.
# Never commit .env. When the app runs in docker-compose, the hostnames below
# are overridden with the internal service names (db, mailpit, minio).
# ---------------------------------------------------------------------------

# --- From the Starter Pack --------------------------------------------------
SMTP_HOST=localhost
SMTP_PORT=1025
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=devkey
S3_SECRET_KEY=devsecret123
S3_BUCKET=coaching-platform-dev
FIRECRAWL_API_KEY=your-firecrawl-key
ANTHROPIC_API_KEY=your-anthropic-key

# --- Database (matches the db service in docker-compose.yml) ---------------
DATABASE_URL=postgresql://dev:dev_local_only@localhost:5432/coaching_platform_dev

# --- App ---------------------------------------------------------------------
PORT=4000
APP_BASE_URL=http://localhost:4000
# Signs the session cookie. Generate one with:  openssl rand -hex 32
SESSION_SECRET=change-me-to-a-long-random-string
MAGIC_LINK_TTL_HOURS=24

# --- Local fake auth shim (Stories 3/4) — served by this app -----------------
AUTH_SHIM_URL=http://localhost:4000/auth-shim/authorize
AUTH_SHIM_PHOTO_BASE_URL=http://localhost:4000

# --- Object storage ----------------------------------------------------------
# Presigned photo URLs must use a host the browser can reach.
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-east-1
# Story 1 creates the bucket by hand in the MinIO console. If it's missing the
# app creates it on startup (set to false to require the manual step).
S3_AUTO_CREATE_BUCKET=true
PHOTO_URL_TTL_SECONDS=900

# --- Firecrawl ---------------------------------------------------------------
FIRECRAWL_API_URL=https://api.firecrawl.dev/v1

# --- Story generation LLM ----------------------------------------------------
# anthropic = what the epic specifies. groq = free-tier option for local runs
# (llm_use.provider will then honestly say 'groq').
LLM_PROVIDER=anthropic
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# Only used to fill llm_use.cost_usd — check https://docs.claude.com/en/docs/about-claude/pricing
ANTHROPIC_INPUT_USD_PER_MTOK=1
ANTHROPIC_OUTPUT_USD_PER_MTOK=5

GROQ_API_KEY=your-groq-key
GROQ_MODEL=llama-3.3-70b-versatile
